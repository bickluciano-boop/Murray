<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.VIBRATE" />

  <application>
    <!-- Servicio de accesibilidad que solo mira los botones de volumen (SosAccessibilityService.kt). El dueño lo activa
         a mano en Ajustes > Accesibilidad: sin eso no hace nada. exported="true" es obligatorio para los servicios de
         accesibilidad; los protege el permiso BIND_ACCESSIBILITY_SERVICE, que solo tiene el sistema. -->
    <service
      android:name="expo.modules.sostrigger.SosAccessibilityService"
      android:exported="true"
      android:label="@string/ojo_sos_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/ojo_sos_accessibility" />
    </service>
    <service
      android:name="expo.modules.sostrigger.SosTaskService"
      android:exported="false" />
  </application>
</manifest>
